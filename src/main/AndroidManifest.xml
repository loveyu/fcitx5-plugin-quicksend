<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 绑定 FcitxRemoteService（protectionLevel="signature"）：
         仅当本插件与 fcitx5-android 共享同一签名证书时生效
         （调试构建双方均使用标准 Android debug keystore 即可）。 -->
    <uses-permission android:name="${fcitxAppId}.permission.IPC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 语音输入：录音 / 模型下载 / 前台服务（麦克风） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="org.fcitx.fcitx5.android.plugin.quicksend.PluginApplication"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <meta-data
            android:name="org.fcitx.fcitx5.android.plugin"
            android:resource="@xml/plugin" />

        <activity
            android:name="org.fcitx.fcitx5.android.plugin.quicksend.PluginActivity"
            android:exported="true"
            android:theme="@style/Theme.QuickSend">
            <intent-filter>
                <action android:name="${fcitxAppId}.plugin.MANIFEST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="org.fcitx.fcitx5.android.plugin.quicksend.MainService"
            android:exported="true"
            android:permission="${fcitxAppId}.permission.PLUGIN">
            <intent-filter>
                <action android:name="${fcitxAppId}.plugin.SERVICE" />
            </intent-filter>
        </service>

        <service android:name="org.fcitx.fcitx5.android.plugin.quicksend.QuickSendOverlayService" />

        <!-- 语音浮层：主程序点语音按钮后 startForegroundService 启动。
             exported + 签名 permission.PLUGIN（与 MainService 一致，仅同签名主程序可启动）；
             foregroundServiceType=microphone 满足 Android 14 后台录音要求。 -->
        <service
            android:name="org.fcitx.fcitx5.android.plugin.quicksend.voice.VoiceOverlayService"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:permission="${fcitxAppId}.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.fcitx.fcitx5.android.plugin.quicksend.voice.START" />
            </intent-filter>
        </service>

        <!-- 语音设置页（模型下载 / 代理）：从 PluginActivity 跳转，不导出 -->
        <activity
            android:name="org.fcitx.fcitx5.android.plugin.quicksend.voice.VoiceSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickSend" />

        <!-- 悬浮按钮外观设置页 -->
        <activity
            android:name="org.fcitx.fcitx5.android.plugin.quicksend.AppearanceActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickSend" />

        <!-- 分享语音调试日志（应用专用外部目录文件经 content:// 授权给其它应用） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
